{
    "name": "@dehasoft/panel-agent",
    "version": "0.1.0",
    "description": "Sends site events (contact form messages, health checks) to the Dehasoft control panel.",
    "license": "MIT",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "files": [
        "dist"
    ],
    "sideEffects": false,
    "scripts": {
        "build": "tsup src/index.ts --format esm,cjs --dts --clean",
        "test": "vitest run"
    },
    "devDependencies": {
        "tsup": "^8.3.0",
        "typescript": "^5.6.0",
        "vitest": "^2.1.0"
    },
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": ">=18"
    }
}
